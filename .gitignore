# =============================================================================
# MacOS files
# =============================================================================

**/.DS_Store

# =============================================================================
# R Files
# =============================================================================

.Rhistory
.Rapp.history
.RData
.Ruserdata

# Environment file with secrets (API tokens) - do not commit
.Renviron

.Rproj.user/
.httr-oauth
*_cache/
/cache

# =============================================================================
# Quarto render output (regenerated by quarto render)
# =============================================================================

/.quarto/
**/*.quarto_ipynb
/_site/
/index_files/
sections/*_files/

# =============================================================================
# Project data
# =============================================================================
# Ignore everything under data/ (PPI + regenerable prep outputs). Data is
# recreated locally by data_management/data_01_quant_consent.R (REDCap API).

/data/*

# Mock data is fake, but it is regenerated by make_mock_data.R
data_management/mock_data/*.RDS

# Any data file anywhere in the project (REDCap exports, prepped data, R
# objects, databases). Nothing in this repo should ever commit participant data.
*.RDS
*.rds
*.RData
*.rda
*.csv
*.tsv
*.xlsx
*.xls
*.sav
*.dta
*.sas7bdat
*.parquet
*.feather
*.duckdb
*.duckdb.wal
*.sqlite
*.db
*.json
!renv/settings.json
*.zip

# Codebook PDF is kept locally for reference only
*.pdf
